{
  "name": "basket-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --conditions=react-server prisma/seed.ts",
    "test:reset": "tsx --conditions=react-server prisma/scripts/reset-test-account.ts",
    "test:seed": "tsx --conditions=react-server prisma/scripts/reset-test-account.ts --seed",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:status:prod": "node prisma/scripts/with-prod.mjs migrate status",
    "db:deploy:prod": "node prisma/scripts/with-prod.mjs migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.82",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.118",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.5",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
