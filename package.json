{
  "name": "basket-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --conditions=react-server prisma/seed.ts && tsx --conditions=react-server prisma/scripts/import-menu.ts",
    "test:reset": "tsx --conditions=react-server prisma/scripts/reset-test-account.ts",
    "test:seed": "tsx --conditions=react-server prisma/scripts/reset-test-account.ts --seed",
    "admin:create-owner": "tsx --conditions=react-server prisma/scripts/create-owner.ts",
    "menu:import": "tsx --conditions=react-server prisma/scripts/import-menu.ts",
    "library:import": "tsx --conditions=react-server prisma/scripts/import-library.ts",
    "menu:apply": "tsx --conditions=react-server --env-file=.env.local prisma/scripts/apply-menu.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:status:prod": "node prisma/scripts/with-prod.mjs migrate status",
    "db:deploy:prod": "node prisma/scripts/with-prod.mjs migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.82",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.118",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lodash": "4.18.1",
    "marked": "16.4.2",
    "motion": "^13.4.5",
    "next": "16.3.8",
    "papaparse": "5.5.3",
    "pg": "^8.23.0",
    "posthog-js": "^1.438.21",
    "prisma": "^7.10.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-responsive-carousel": "3.2.23",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/lodash": "4.17.20",
    "@types/node": "^22.20.5",
    "@types/papaparse": "5.3.16",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
