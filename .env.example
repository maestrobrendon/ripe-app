# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Postgres connection string (Neon / Supabase / any Postgres).
DATABASE_URL=

# Optional: a local-only test account created by `npm run seed`.
# Ignored when NODE_ENV=production. Leave blank to skip.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# Cloudinary. Delivery works off the cloud name alone (public unsigned URLs).
# Key/secret are ONLY for the one-off image backfill script and must never be
# referenced in app code or shipped client-side.
CLOUDINARY_CLOUD_NAME=dusynu0kv
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend, for transactional email (currently: password reset links).
# Without a key set, reset links are logged to the server console instead
# of emailed, so the flow stays testable locally. Provisioned via the Vercel
# Marketplace (`vercel integration add resend`), which sets RESEND_API_KEY
# and RESEND_EMAIL_DOMAIN automatically. RESEND_FROM_EMAIL must be on a
# domain verified in the Resend dashboard (Domains -> DNS records) -- until
# then, "onboarding@resend.dev" works but only delivers to the account
# owner's own address, not real users.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
RESEND_FROM_EMAIL="Ripe <no-reply@yourdomain.com>"
