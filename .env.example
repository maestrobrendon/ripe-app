# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Postgres connection string (Neon / Supabase / any Postgres).
DATABASE_URL=

# Optional: a local-only test account created by `npm run seed`.
# Ignored when NODE_ENV=production. Leave blank to skip.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
